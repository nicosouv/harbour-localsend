[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Name=LocalSend
Icon=harbour-localsend
Exec=harbour-localsend
Comment=Send files over your local network
Categories=Network;FileTransfer;
# Sharing into the app: this name is what qml/components/ShareTarget.qml sets
# as its method, and the two must agree or the entry appears and does nothing.
X-Share-Methods=files;
# So that sharing into a running app reuses it instead of starting a second
# one, which would try to bind the same port and fail.
X-Nemo-Single-Instance=yes

[X-Share Method files]
Description=Send with LocalSend
Description[fr]=Envoyer avec LocalSend
Description[de]=Mit LocalSend senden
Description[es]=Enviar con LocalSend
Description[fi]=Lähetä LocalSendillä
Description[it]=Invia con LocalSend
Description[nb_NO]=Send med LocalSend
# Everything. LocalSend moves bytes and does not care what they are; a list of
# types here would only enumerate the things it needlessly refuses.
Capabilities=*
SupportsMultipleFiles=yes

[X-Sailjail]
# Each entry below is here because something stops working without it, checked
# against the definitions in sailfishos/sailjail-permissions rather than
# guessed at. Base.permission already covers notifications and the cover
# actions, so neither is listed.
#
#   Internet        Base sets "net none" and "protocol unix", so without this
#                   the app has no sockets at all - not merely no Internet.
#                   It grants inet/inet6, which is what the multicast
#                   announcements, the listening server and the transfers
#                   themselves need. Nothing here ever leaves the local
#                   network; the name is about the socket family, not a
#                   destination.
#   Downloads       The default place received files are written.
#   Documents       )
#   Pictures        ) Base blacklists every XDG directory; each of these
#   Videos          ) un-blacklists one of them. They are what the file
#   Music           ) picker can read from, and so what can be sent.
#   RemovableMedia  Base sets "disable-mnt", which hides the SD card. Without
#                   it, media kept on a card can be neither sent nor saved to.
#   MediaIndexing   Grants "dbus-user.talk org.freedesktop.Tracker3.Miner.Files".
#                   The file picker's Documents, Images, Videos, Music and
#                   Downloads tabs are all DocumentGalleryModel, which is
#                   tracker-backed: without this they come up empty and only
#                   the File System tab works. It was left out of the first
#                   release on least-privilege grounds, which was a mistake -
#                   it is not an optional extra, it is how files get picked.
#
# Deliberately absent: UserDirs, which is Documents, Downloads, Music,
# Pictures, Videos and PublicDir in one - listing the five we use leaves
# ~/Public alone. Sharing is absent too, and cannot be added: Harbour does not
# allow it. Being a share target does not appear to need it - the share
# framework calls us on the bus name Sailjail already grants, rather than the
# other way round.
#
# Nothing in this section may contain an opening bracket, not even inside a
# comment. Harbour's validator cuts the section off at the first one and then
# reports it as empty; scripts/check_desktop.py catches that here instead.
Permissions=Internet;Downloads;Documents;Pictures;Videos;Music;RemovableMedia;MediaIndexing
# These two are not cosmetic. Sailjail gives the app
# ~/.local/share/<OrganizationName>/<ApplicationName> and lets it own exactly
# the bus name <OrganizationName>.<ApplicationName>, which is the name the
# share framework calls. Changing either orphans the stored identity, the
# known-device list and the history along with it.
OrganizationName=harbour-localsend
ApplicationName=harbour-localsend
# Lets the share sheet start the app when it is not already running. Without
# it, sharing only works while LocalSend happens to be open.
ExecDBus=/usr/bin/harbour-localsend
